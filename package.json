{
  "name": "typescript-template",
  "version": "1.1.0",
  "main": "index.js",
  "type": "module",
  "devDependencies": {
    "@rollup/plugin-typescript": "12.3.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "clean-css": "5.3.3",
    "cross-env": "10.1.0",
    "ect-bin": "1.4.1",
    "eslint": "10.8.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "html-minifier": "4.0.0",
    "npm-run-all": "4.1.5",
    "roadroller": "2.1.0",
    "terser": "5.50.0",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "scripts": {
    "serve": "npm-run-all --parallel tsc vite",
    "build": "cross-env LEVEL_2_BUILD=true vite build",
    "find-best-roadroller": "node find-best-roadroller.js",
    "build-with-best-roadroller": "cross-env USE_RR_CONFIG=true vite build",
    "lint": "eslint --ext .ts,.js,.vue --ignore-path .gitignore src",
    "vite": "vite serve",
    "tsc": "tsc --watch --noEmit"
  },
  "author": "Rob Louie"
}
